# Chain RPC endpoint
ETH_PROVIDER_URL=http://localhost:8545

# Deployer private key (Hardhat default account 0)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract addresses (set after running: yarn contracts deploy)
UNIREP_ADDRESS=
KARMA_BRIDGE_ADDRESS=

# Moltbook bot API key (optional — dev mode works without it)
MOLTBOOK_BOT_API_KEY=

# AES-256-GCM key for encrypting stored ZK identities
ENCRYPTION_KEY=change-me-in-production

# Server port
PORT=3000

# SQLite database path (defaults to packages/relay/anonbook.db)
# DB_PATH=
